# Public, non-secret build channel used for feature and service configuration.
EXPO_PUBLIC_APP_ENV=development

# Public Firebase identifiers are safe to expose in a client application. Access
# is enforced by Authentication, App Check, Security Rules, and server code.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=hakeemi-portfolio-dev
# Keep true for local Emulator Suite development. Set false for a seeded cloud
# development/preview build.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true

# Optional overrides for the native Firebase config files. When unset, the app
# uses the ignored .firebase/development/ files if they exist and otherwise
# falls back to the committed emulator-only placeholders in
# firebase/templates/emulator/, so no Firebase project is required for local
# emulator development. EAS file variables supply real files for preview and
# production builds.
# GOOGLE_SERVICES_JSON=./.firebase/development/google-services.json
# GOOGLE_SERVICES_INFO_PLIST=./.firebase/development/GoogleService-Info.plist
