{
  "name": "hakeemi",
  "main": "expo-router/entry",
  "version": "2.0.0",
  "engines": {
    "node": ">=22.13 <25"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "25.1.0",
    "@react-native-firebase/auth": "25.1.0",
    "@react-native-firebase/firestore": "25.1.0",
    "@react-native-firebase/functions": "25.1.0",
    "@react-native-firebase/messaging": "^25.1.0",
    "@tanstack/react-query": "^5.101.2",
    "expo": "~57.0.7",
    "expo-build-properties": "~57.0.6",
    "expo-calendar": "~57.0.1",
    "expo-constants": "~57.0.6",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.6",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.82.0",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "expo-doctor": "^1.20.1",
    "firebase": "12.16.0",
    "firebase-tools": "15.24.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.5",
    "simple-git-hooks": "^2.13.1",
    "test-renderer": "^1.2.0",
    "tsx": "4.23.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "firebase:emulators": "firebase emulators:start --project hakeemi-portfolio-dev",
    "firebase:emulators:export": "firebase emulators:export .firebase/emulator-data --project hakeemi-portfolio-dev --force",
    "firebase:emulators:seeded": "firebase emulators:start --project hakeemi-portfolio-dev --import .firebase/emulator-data --export-on-exit .firebase/emulator-data",
    "firebase:rules:test": "firebase emulators:exec --project demo-hakeemi --only firestore,storage \"npm run firebase:rules:test:run\"",
    "firebase:rules:test:run": "node --import tsx --test --test-concurrency=1 firebase/tests/security-rules.test.ts",
    "firebase:profile:test": "npm --prefix functions run build && firebase emulators:exec --project demo-hakeemi --only auth,firestore,functions \"npm run firebase:profile:test:run\"",
    "firebase:profile:test:run": "node --import tsx --test --test-concurrency=1 firebase/tests/profile-bootstrap.test.ts",
    "firebase:booking:test": "npm --prefix functions run build && firebase emulators:exec --project demo-hakeemi --only auth,firestore,functions \"npm run firebase:booking:test:run\"",
    "firebase:booking:test:run": "node --import tsx --test --test-concurrency=1 firebase/tests/appointment-booking.test.ts",
    "firebase:appointment-management:test": "npm --prefix functions run build && firebase emulators:exec --project demo-hakeemi --only auth,firestore,functions \"npm run firebase:appointment-management:test:run\"",
    "firebase:appointment-management:test:run": "node --import tsx --test --test-concurrency=1 firebase/tests/appointment-management.test.ts",
    "firebase:notification-token:test": "npm --prefix functions run build && firebase emulators:exec --project demo-hakeemi --only auth,firestore,functions \"npm run firebase:notification-token:test:run\"",
    "firebase:notification-token:test:run": "node --import tsx --test --test-concurrency=1 firebase/tests/notification-token.test.ts",
    "firebase:seed:development": "npm --prefix functions run seed -- --project hakeemi-portfolio-dev",
    "firebase:seed:emulator": "npm --prefix functions run seed -- --project hakeemi-portfolio-dev --emulator",
    "firebase:seed:emulator:exec": "firebase emulators:exec --project hakeemi-portfolio-dev --only firestore \"npm run firebase:seed:emulator\"",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "test": "jest --runInBand",
    "test:functions": "npm --prefix functions test",
    "test:watch": "jest --watch",
    "typecheck": "npm run typecheck:app && npm run typecheck:firebase && npm run typecheck:functions",
    "typecheck:app": "tsc --noEmit",
    "typecheck:firebase": "tsc -p firebase/tsconfig.json --noEmit",
    "typecheck:functions": "npm --prefix functions run typecheck",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:functions && expo-doctor",
    "prepare": "simple-git-hooks"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yml,yaml}": "prettier --write",
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "private": true
}
